{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@jmouse/ui-kit": [
        "../../packages/ui-kit/src/index.ts"
      ],
      "@jmouse/explorer": [
        "../../packages/explorer/src/index.ts"
      ],
      "@jmouse/ui-kit/code": [
        "../../packages/ui-kit/src/code/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
