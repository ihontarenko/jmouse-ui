{
  "name": "@jmouse/avatars",
  "version": "0.1.0",
  "description": "Generated avatars: eight drawing strategies, one descriptor token, zero dependencies. The React picker is a separate entry point.",
  "license": "UNLICENSED",
  "author": "Ivan Hontarenko",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./picker": {
      "types": "./dist/picker.d.ts",
      "default": "./dist/picker.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "node scripts/clean.mjs"
  },
  "peerDependencies": {
    "@jmouse/ui": ">=0.1.0",
    "lucide-react": ">=1.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@jmouse/ui": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jmouse/ui": "*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
