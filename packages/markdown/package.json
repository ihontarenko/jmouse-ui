{
  "name": "@jmouse/markdown",
  "version": "0.2.0",
  "description": "A plugin-driven Markdown renderer and editor. Knows CommonMark and two block shapes; everything else is a plugin you construct and hand in.",
  "license": "MIT",
  "author": "Ivan Hontarenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihontarenko/jmouse-markdown.git"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./jme": {
      "types": "./dist/jme.d.ts",
      "import": "./dist/jme.js"
    },
    "./wavedrom": {
      "types": "./dist/wavedrom.d.ts",
      "import": "./dist/wavedrom.js"
    },
    "./styles.css": "./dist/markdown.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@uiw/react-codemirror": "^4.25.11",
    "katex": "^0.16.47",
    "mermaid": "^11.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "json5": "^2.2.3",
    "wavedrom": "^3.6.2"
  },
  "peerDependenciesMeta": {
    "json5": {
      "optional": true
    },
    "wavedrom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^4.3.4",
    "katex": "^0.16.47",
    "mermaid": "^11.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
