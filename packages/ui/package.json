{
  "name": "@jmouse/ui",
  "version": "0.1.0",
  "description": "The render layer shared by Innoventa, Tessera and Kiwi — shadcn/ui primitives, the theme mechanism, and the class helper.",
  "license": "UNLICENSED",
  "author": "Ivan Hontarenko",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "default": "./dist/presets/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./presets/themes.css": "./dist/presets/themes.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "node scripts/clean.mjs"
  },
  "peerDependencies": {
    "lucide-react": ">=1.0.0",
    "radix-ui": ">=1.6.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-hook-form": ">=7.50.0",
    "recharts": ">=3.0.0",
    "sonner": ">=2.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.25.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "typescript": "~6.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
