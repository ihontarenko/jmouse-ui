{
  "name": "@jmouse/codemirror",
  "version": "0.1.0",
  "description": "The CodeMirror layer five interfaces share — the .jmp and jME grammars, the tags they emit, the syntax palette, and the editor and static-render machinery around them.",
  "license": "UNLICENSED",
  "author": "Ivan Hontarenko",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./palettes": {
      "types": "./dist/palettes.d.ts",
      "default": "./dist/palettes.js"
    },
    "./styles.css": "./dist/styles.css",
    "./themes": {
      "types": "./dist/themes.d.ts",
      "default": "./dist/themes.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@codemirror/lang-markdown": ">=6.5.0",
    "@codemirror/language": ">=6.12.0",
    "@codemirror/state": ">=6.7.0",
    "@codemirror/view": ">=6.43.0",
    "@lezer/common": ">=1.5.0",
    "@lezer/highlight": ">=1.2.0",
    "style-mod": ">=4.1.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "style-mod": "^4.1.3",
    "typescript": "~6.0.2",
    "vitest": "^2.1.9",
    "react": "^19.2.7",
    "@types/react": "^19.2.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "thememirror": "^2.0.1"
  }
}
