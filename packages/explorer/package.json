{
  "name": "@jmouse/explorer",
  "version": "0.1.0",
  "description": "The embeddable file manager drawn with @jmouse/ui-kit: a product supplies an adapter over its own routes, and what may be done to a file follows from what that adapter can do.",
  "license": "UNLICENSED",
  "author": "Ivan Hontarenko",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@jmouse/file-handling": "^0.1.0"
  },
  "peerDependencies": {
    "@jmouse/ui-kit": ">=0.1.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@jmouse/ui-kit": "*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
