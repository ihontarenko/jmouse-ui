{
  "name": "@jmouse/validation",
  "version": "0.1.0",
  "description": "The .jmv validation builder every product shares — rows on one tab, the document they are on the other. The language itself is never written here: the server composes and reads it.",
  "license": "UNLICENSED",
  "author": "Ivan Hontarenko",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "node scripts/clean.mjs"
  },
  "peerDependencies": {
    "@jmouse/ui": ">=0.1.0",
    "@tanstack/react-query": ">=5.0.0",
    "lucide-react": ">=1.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "@jmouse/codemirror": ">=0.1.0",
    "@uiw/react-codemirror": ">=4.23.0",
    "@codemirror/lint": ">=6.0.0",
    "@codemirror/view": ">=6.0.0"
  },
  "devDependencies": {
    "@jmouse/ui": "*",
    "@tanstack/react-query": "^5.90.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2",
    "@jmouse/codemirror": "*",
    "@uiw/react-codemirror": "^4.25.11",
    "@codemirror/view": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
