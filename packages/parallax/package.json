{
  "name": "@jmouse/parallax",
  "version": "0.1.0",
  "description": "Parallax's headless machinery — the engine's transport and wire types, the drawing stage, circuits, instruments, graphs and scenes — with no React and no product inside.",
  "license": "UNLICENSED",
  "author": "Ivan Hontarenko",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
